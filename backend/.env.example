# Neon PostgreSQL Cloud Database Connection
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full"

# Application Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET="your_jwt_secret_key_change_in_production"
FRONTEND_URL="http://localhost:3000"

# MSG91 OTP Authentication Configuration
MSG91_AUTH_KEY="your_msg91_auth_key_here"

# Twilio Programmable SMS Integration
# TWILIO_ACCOUNT_SID starts with 'AC' (34 characters)
TWILIO_ACCOUNT_SID="AC00000000000000000000000000000000"
# TWILIO_AUTH_TOKEN is your 32-character hexadecimal auth token
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
# TWILIO_MESSAGING_SERVICE_SID starts with 'MG' (34 characters)
TWILIO_MESSAGING_SERVICE_SID="MG00000000000000000000000000000000"
# Set to 'true' to simulate SMS locally in memory without API calls or credit consumption.
# Set to 'false' to dispatch real SMS through Twilio Messaging Service.
TWILIO_MOCK_MODE=true
