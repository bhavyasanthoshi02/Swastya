# Runtime database connection URL (PostgreSQL), used by the application via @prisma/adapter-pg.
# Local: a normal local URL. Neon: use the POOLED host (contains "-pooler") with sslmode=require.
DATABASE_URL="postgresql://username:password@localhost:5432/swastya_db?schema=public"

# Direct (non-pooled) connection URL, used ONLY by the Prisma CLI (migrate, db push, introspection)
# and for pg_restore. Neon: use the DIRECT host (no "-pooler") with sslmode=require.
# Optional locally: if unset, the Prisma CLI falls back to DATABASE_URL.
DIRECT_URL="postgresql://username:password@localhost:5432/swastya_db?schema=public"

# Note for automated testing:
# Automated tests must ALWAYS target local swastya_test (configured in .env.test) and NEVER target Neon.

# Secret key used for signing and verifying JSON Web Tokens (min 32 characters recommended)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"

# Frontend Application Origin for CORS configuration (comma-separated for multiple origins)
FRONTEND_URL="http://localhost:3000"

# Backend HTTP Server Port
PORT=5000
