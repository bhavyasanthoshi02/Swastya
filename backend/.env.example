# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/swastya_db?schema=public"

# Secret key used for signing and verifying JSON Web Tokens (min 32 characters recommended)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"

# Frontend Application Origin for CORS configuration (comma-separated for multiple origins)
FRONTEND_URL="http://localhost:3000"

# Backend HTTP Server Port
PORT=5000
