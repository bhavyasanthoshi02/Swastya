generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bloodbanks {
  bloodbankid        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userid             String            @unique @db.Uuid
  bloodbankname      String            @db.VarChar(255)
  licensenumber      String            @unique @db.VarChar(100)
  contactpersonname  String            @db.VarChar(100)
  contactpersonphone String            @db.VarChar(15)
  address            String            @db.VarChar(255)
  city               String            @db.VarChar(100)
  state              String            @db.VarChar(100)
  pincode            String            @db.VarChar(10)
  latitude           Decimal?          @db.Decimal(9, 6)
  longitude          Decimal?          @db.Decimal(9, 6)
  approvalstatus     approval_status?  @default(PENDING)
  createdat          DateTime?         @default(now()) @db.Timestamp(6)
  updatedat          DateTime?         @default(now()) @db.Timestamp(6)
  users              users             @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "fk_bloodbank_user")
  donationhistory    donationhistory[]
  inventory          inventory[]
  inventoryledger    inventoryledger[]
  inventoryunits     inventoryunits[]
  requisitionassignments requisitionassignments[]
  bloodreservations  bloodreservations[]
  unitdispositionhistory unitdispositionhistory[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bloodrequests {
  requestid            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdbyuserid      String                 @db.Uuid
  requesterid          String?                @db.Uuid
  hospitalid           String?                @db.Uuid
  patientname          String                 @db.VarChar(100)
  patientage           Int
  patientgender        gender_type
  patientcontact       String                 @db.VarChar(15)
  bloodgroup           blood_group
  bloodcomponent       blood_component
  unitsrequired        Int
  urgencylevel         urgency_level
  isemergency          Boolean?               @default(false)
  searchradius         Int?                   @default(5)
  latitude             Decimal?               @db.Decimal(9, 6)
  longitude            Decimal?               @db.Decimal(9, 6)
  requiredby           DateTime               @db.Timestamp(6)
  status               request_status?        @default(CREATED)
  notes                String?
  createdat            DateTime?              @default(now()) @db.Timestamp(6)
  updatedat            DateTime?              @default(now()) @db.Timestamp(6)
  users                users                  @relation(fields: [createdbyuserid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_request_creator")
  hospitals            hospitals?             @relation(fields: [hospitalid], references: [hospitalid], onDelete: NoAction, onUpdate: NoAction, map: "fk_request_hospital")
  requesters           requesters?            @relation(fields: [requesterid], references: [requesterid], onDelete: NoAction, onUpdate: NoAction, map: "fk_request_requester")
  donationhistory      donationhistory[]
  hospitalcoordination hospitalcoordination[]
  notification         notification[]
  prescription         prescription?
  prescriptionhistory  prescriptionhistory[]
  requeststatushistory requeststatushistory[]
  emergencybroadcasts  emergencybroadcasts[]
  broadcastdeliveries  broadcastdeliveries[]
  emergencyschedulerjobs emergencyschedulerjobs[]
  requisitionassignments requisitionassignments[]
  bloodreservations    bloodreservations[]
  clinicalcrossmatches clinicalcrossmatches[]

  @@index([status], map: "idx_bloodrequests_status")
}

model donationhistory {
  donationhistoryid  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donorid            String               @db.Uuid
  requestid          String?              @db.Uuid
  unitsdonated       Int
  donationdate       DateTime             @db.Date
  bloodbankid        String?              @db.Uuid
  hospitalid         String?              @db.Uuid
  remarks            String?
  isimported         Boolean?             @default(false)
  sourcerecordid     String?              @db.VarChar(100)
  bloodcomponent     blood_component?     @default(WHOLE_BLOOD)
  verificationstatus verification_status? @default(PENDING)
  createdat          DateTime?            @default(now()) @db.Timestamp(6)
  bloodbanks         bloodbanks?          @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: NoAction, onUpdate: NoAction, map: "fk_donation_bloodbank")
  donors             donors               @relation(fields: [donorid], references: [donorid], onDelete: NoAction, onUpdate: NoAction, map: "fk_donation_donor")
  hospitals          hospitals?           @relation(fields: [hospitalid], references: [hospitalid], onDelete: NoAction, onUpdate: NoAction, map: "fk_donation_hospital")
  bloodrequests      bloodrequests?       @relation(fields: [requestid], references: [requestid], onDelete: NoAction, onUpdate: NoAction, map: "fk_donation_request")
}

model donors {
  donorid            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userid             String               @unique @db.Uuid
  bloodgroup         blood_group
  dateofbirth        DateTime             @db.Date
  gender             gender_type
  weight             Decimal?             @db.Decimal(5, 2)
  city               String               @db.VarChar(100)
  state              String               @db.VarChar(100)
  pincode            String               @db.VarChar(10)
  latitude           Decimal?             @db.Decimal(9, 6)
  longitude          Decimal?             @db.Decimal(9, 6)
  availabilitystatus availability_status? @default(AVAILABLE)
  iseligible         Boolean?             @default(true)
  lastdonationdate   DateTime?            @db.Date
  createdat          DateTime?            @default(now()) @db.Timestamp(6)
  updatedat          DateTime?            @default(now()) @db.Timestamp(6)
  address            String?              @db.VarChar(255)
  donationhistory    donationhistory[]
  hospitaldonors     hospitaldonors[]
  broadcastdeliveries broadcastdeliveries[]
  users              users                @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "fk_donor_user")

  @@index([bloodgroup], map: "idx_donors_bloodgroup")
}

model hospitalcoordination {
  coordinationid                                           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestid                                                String               @db.Uuid
  fromhospitalid                                           String               @db.Uuid
  tohospitalid                                             String               @db.Uuid
  status                                                   coordination_status? @default(PENDING)
  remarks                                                  String?
  createdat                                                DateTime?            @default(now()) @db.Timestamp(6)
  respondedat                                              DateTime?            @db.Timestamp(6)
  hospitals_hospitalcoordination_fromhospitalidTohospitals hospitals            @relation("hospitalcoordination_fromhospitalidTohospitals", fields: [fromhospitalid], references: [hospitalid], onDelete: NoAction, onUpdate: NoAction, map: "fk_coordination_from_hospital")
  bloodrequests                                            bloodrequests        @relation(fields: [requestid], references: [requestid], onDelete: NoAction, onUpdate: NoAction, map: "fk_coordination_request")
  hospitals_hospitalcoordination_tohospitalidTohospitals   hospitals            @relation("hospitalcoordination_tohospitalidTohospitals", fields: [tohospitalid], references: [hospitalid], onDelete: NoAction, onUpdate: NoAction, map: "fk_coordination_to_hospital")
}

model hospitals {
  hospitalid                                                          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userid                                                              String                 @unique @db.Uuid
  hospitalname                                                        String                 @db.VarChar(255)
  registrationnumber                                                  String                 @unique @db.VarChar(100)
  contactpersonname                                                   String                 @db.VarChar(100)
  contactpersonphone                                                  String                 @db.VarChar(15)
  address                                                             String                 @db.VarChar(255)
  city                                                                String                 @db.VarChar(100)
  state                                                               String                 @db.VarChar(100)
  pincode                                                             String                 @db.VarChar(10)
  latitude                                                            Decimal?               @db.Decimal(9, 6)
  longitude                                                           Decimal?               @db.Decimal(9, 6)
  approvalstatus                                                      approval_status?       @default(PENDING)
  createdat                                                           DateTime?              @default(now()) @db.Timestamp(6)
  updatedat                                                           DateTime?              @default(now()) @db.Timestamp(6)
  bloodrequests                                                       bloodrequests[]
  donationhistory                                                     donationhistory[]
  hospitaldonors                                                      hospitaldonors[]
  hospitalcoordination_hospitalcoordination_fromhospitalidTohospitals hospitalcoordination[] @relation("hospitalcoordination_fromhospitalidTohospitals")
  hospitalcoordination_hospitalcoordination_tohospitalidTohospitals   hospitalcoordination[] @relation("hospitalcoordination_tohospitalidTohospitals")
  users                                                               users                  @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "fk_hospital_user")
  prescription                                                        prescription[]
  prescriptionhistory                                                 prescriptionhistory[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory {
  inventoryid    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bloodbankid    String          @db.Uuid
  bloodgroup     blood_group
  bloodcomponent blood_component
  unitsavailable Int             @default(0)
  unitsreserved  Int             @default(0)
  unitsquarantined Int           @default(0)
  islegacyreconciled Boolean       @default(true)
  expirydate     DateTime        @db.Date
  lastupdated    DateTime?       @default(now()) @db.Timestamp(6)
  createdat      DateTime?       @default(now()) @db.Timestamp(6)
  updatedat      DateTime?       @default(now()) @db.Timestamp(6)
  bloodbanks     bloodbanks        @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: Cascade, onUpdate: NoAction, map: "fk_inventory_bloodbank")
  inventoryledger inventoryledger[]
  inventoryunits inventoryunits[]

  @@unique([bloodbankid, bloodgroup, bloodcomponent, expirydate], map: "uq_inventory")
  @@index([bloodgroup], map: "idx_inventory_bloodgroup")
}

model notification {
  notificationid String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userid         String            @db.Uuid
  requestid      String?           @db.Uuid
  type           notification_type
  title          String            @db.VarChar(255)
  message        String
  isread         Boolean?          @default(false)
  sentat         DateTime?         @default(now()) @db.Timestamp(6)
  readat         DateTime?         @db.Timestamp(6)
  bloodrequests  bloodrequests?    @relation(fields: [requestid], references: [requestid], onDelete: NoAction, onUpdate: NoAction, map: "fk_notification_request")
  users          users             @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_user")
  broadcastdeliveries broadcastdeliveries[]

  @@index([userid], map: "idx_notification_user")
}

model prescription {
  prescriptionid       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestid            String                @unique @db.Uuid
  fileurl              String
  originalfilename     String?               @db.VarChar(255)
  mimetype             String?               @db.VarChar(100)
  filesize             Int?
  doctorname           String                @db.VarChar(100)
  hospitalname         String                @db.VarChar(255)
  status               prescription_status?  @default(PENDING)
  verifiedbyhospitalid String?               @db.Uuid
  verificationdate     DateTime?             @db.Timestamp(6)
  remarks              String?
  uploadedat           DateTime?             @default(now()) @db.Timestamp(6)
  createdat            DateTime?             @default(now()) @db.Timestamp(6)
  updatedat            DateTime?             @default(now()) @db.Timestamp(6)
  hospitals            hospitals?            @relation(fields: [verifiedbyhospitalid], references: [hospitalid], onDelete: NoAction, onUpdate: NoAction, map: "fk_prescription_hospital")
  bloodrequests        bloodrequests         @relation(fields: [requestid], references: [requestid], onDelete: NoAction, onUpdate: NoAction, map: "fk_prescription_request")
  prescriptionhistory  prescriptionhistory[]
}

model prescriptionhistory {
  historyid            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prescriptionid       String               @db.Uuid
  requestid            String               @db.Uuid
  fileurl              String
  originalfilename     String?              @db.VarChar(255)
  mimetype             String?              @db.VarChar(100)
  filesize             Int?
  status               prescription_status
  reviewedbyhospitalid String?              @db.Uuid
  remarks              String?
  createdat            DateTime?            @default(now()) @db.Timestamp(6)
  prescription         prescription         @relation(fields: [prescriptionid], references: [prescriptionid], onDelete: Cascade, onUpdate: NoAction, map: "fk_history_prescription")
  bloodrequests        bloodrequests        @relation(fields: [requestid], references: [requestid], onDelete: Cascade, onUpdate: NoAction, map: "fk_history_request")
  hospitals            hospitals?           @relation(fields: [reviewedbyhospitalid], references: [hospitalid], onDelete: SetNull, onUpdate: NoAction, map: "fk_history_hospital")
}

model emergencybroadcasts {
  broadcastid         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestid           String                @db.Uuid
  triggeredbyuserid   String                @db.Uuid
  triggertype         String                @db.VarChar(50)
  triggerreason       String?
  radiuskm            Int                   @default(5)
  status              String                @default("ACTIVE") @db.VarChar(50)
  totalmatched        Int                   @default(0)
  totalnotified       Int                   @default(0)
  totalresponded      Int                   @default(0)
  createdat           DateTime?             @default(now()) @db.Timestamp(6)
  updatedat           DateTime?             @default(now()) @db.Timestamp(6)
  bloodrequests       bloodrequests         @relation(fields: [requestid], references: [requestid], onDelete: Cascade, onUpdate: NoAction, map: "fk_broadcast_request")
  users               users                 @relation(fields: [triggeredbyuserid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_broadcast_trigger_user")
  broadcastdeliveries broadcastdeliveries[]

  @@index([requestid], map: "idx_emergencybroadcasts_request")
  @@index([status], map: "idx_emergencybroadcasts_status")
}

model broadcastdeliveries {
  deliveryid          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  broadcastid         String               @db.Uuid
  requestid           String               @db.Uuid
  donorid             String               @db.Uuid
  donoruserid         String               @db.Uuid
  matchtype           String               @db.VarChar(50)
  distancekm          Decimal?             @db.Decimal(6, 2)
  deliverystatus      String               @default("DELIVERED") @db.VarChar(50)
  notificationid      String?              @db.Uuid
  attemptcount        Int                  @default(1)
  firstattemptat      DateTime?            @default(now()) @db.Timestamp(6)
  lastattemptat       DateTime?            @default(now()) @db.Timestamp(6)
  failuremessage      String?
  response            String?              @db.VarChar(50)
  respondedat         DateTime?            @db.Timestamp(6)
  transitstatus       String?              @db.VarChar(50)
  transitnotes        String?
  estimatedarrival    String?              @db.VarChar(100)
  startedat           DateTime?            @db.Timestamp(6)
  reachedat           DateTime?            @db.Timestamp(6)
  completedat         DateTime?            @db.Timestamp(6)
  createdat           DateTime?            @default(now()) @db.Timestamp(6)
  updatedat           DateTime?            @default(now()) @db.Timestamp(6)
  emergencybroadcasts emergencybroadcasts  @relation(fields: [broadcastid], references: [broadcastid], onDelete: Cascade, onUpdate: NoAction, map: "fk_delivery_broadcast")
  bloodrequests       bloodrequests        @relation(fields: [requestid], references: [requestid], onDelete: Cascade, onUpdate: NoAction, map: "fk_delivery_request")
  donors              donors               @relation(fields: [donorid], references: [donorid], onDelete: Cascade, onUpdate: NoAction, map: "fk_delivery_donor")
  users               users                @relation(fields: [donoruserid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "fk_delivery_donoruser")
  notification        notification?        @relation(fields: [notificationid], references: [notificationid], onDelete: SetNull, onUpdate: NoAction, map: "fk_delivery_notification")

  @@unique([broadcastid, donorid], map: "uq_broadcast_donor")
  @@index([requestid], map: "idx_broadcastdeliveries_request")
  @@index([donorid], map: "idx_broadcastdeliveries_donor")
  @@index([donoruserid], map: "idx_broadcastdeliveries_donoruser")
}

model emergencyschedulerjobs {
  jobid          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestid      String        @db.Uuid
  jobtype        String        @default("FOLLOW_UP_ESCALATION") @db.VarChar(50)
  status         String        @default("PENDING") @db.VarChar(50)
  scheduledfor   DateTime      @db.Timestamp(6)
  lockeduntil    DateTime?     @db.Timestamp(6)
  lockedby       String?       @db.VarChar(100)
  attemptcount   Int           @default(0)
  maxattempts    Int           @default(5)
  lasterror      String?
  idempotencykey String?       @unique @db.VarChar(255)
  createdat      DateTime?     @default(now()) @db.Timestamp(6)
  updatedat      DateTime?     @default(now()) @db.Timestamp(6)
  completedat    DateTime?     @db.Timestamp(6)
  bloodrequests  bloodrequests @relation(fields: [requestid], references: [requestid], onDelete: Cascade, onUpdate: NoAction, map: "fk_scheduler_job_request")

  @@index([status, scheduledfor], map: "idx_scheduler_jobs_claim")
  @@index([requestid], map: "idx_scheduler_jobs_request")
  @@index([status], map: "idx_scheduler_jobs_status")
}

model requesters {
  requesterid   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userid        String          @unique @db.Uuid
  address       String          @db.VarChar(255)
  city          String          @db.VarChar(100)
  state         String          @db.VarChar(100)
  pincode       String          @db.VarChar(10)
  latitude      Decimal?        @db.Decimal(9, 6)
  longitude     Decimal?        @db.Decimal(9, 6)
  createdat     DateTime?       @default(now()) @db.Timestamp(6)
  updatedat     DateTime?       @default(now()) @db.Timestamp(6)
  bloodrequests bloodrequests[]
  users         users           @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction, map: "fk_requester_user")
}

model requeststatushistory {
  historyid       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestid       String          @db.Uuid
  oldstatus       request_status?
  newstatus       request_status
  changedbyuserid String?         @db.Uuid
  remarks         String?
  changedat       DateTime?       @default(now()) @db.Timestamp(6)
  bloodrequests   bloodrequests   @relation(fields: [requestid], references: [requestid], onDelete: Cascade, onUpdate: NoAction, map: "fk_statushistory_request")
  users           users?          @relation(fields: [changedbyuserid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_statushistory_user")
}

model users {
  userid               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @db.VarChar(100)
  email                String                 @unique @db.VarChar(255)
  phonenumber          String?                @db.VarChar(15)
  password             String                 @db.VarChar(255)
  role                 user_role
  isactive             Boolean?               @default(true)
  emailverified        Boolean?               @default(false)
  createdat            DateTime?              @default(now()) @db.Timestamp(6)
  updatedat            DateTime?              @default(now()) @db.Timestamp(6)
  bloodbanks           bloodbanks?
  bloodrequests        bloodrequests[]
  donors               donors?
  hospitals            hospitals?
  notification         notification[]
  requesters           requesters?
  requeststatushistory requeststatushistory[]
  donoractivationtokens donoractivationtokens[]
  emergencybroadcasts  emergencybroadcasts[]
  broadcastdeliveries  broadcastdeliveries[]
  inventoryledger      inventoryledger[]
  unitscreeningrecords_testedby unitscreeningrecords[] @relation("ScreeningTestedBy")
  unitscreeningrecords_verifiedby unitscreeningrecords[] @relation("ScreeningVerifiedBy")
  unitscreeningrecords_supersededby unitscreeningrecords[] @relation("ScreeningSupersededBy")
  requisitionassignments_assignedby requisitionassignments[] @relation("AssignmentAssignedBy")
  requisitionassignments_respondedby requisitionassignments[] @relation("AssignmentRespondedBy")
  bloodreservations_reservedby bloodreservations[] @relation("ReservationReservedBy")
  bloodreservations_cancelledby bloodreservations[] @relation("ReservationCancelledBy")
  clinicalcrossmatches_testedby clinicalcrossmatches[] @relation("CrossmatchTestedBy")
  clinicalcrossmatches_verifiedby clinicalcrossmatches[] @relation("CrossmatchVerifiedBy")
  unitdispositionhistory_actor unitdispositionhistory[] @relation("DispositionActor")

  @@index([email], map: "idx_users_email")
}

model hospitaldonors {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospitalid       String    @db.Uuid
  donorid          String    @db.Uuid
  sourceidentifier String?   @db.VarChar(100)
  status           String?   @default("ACTIVE") @db.VarChar(50)
  createdat        DateTime? @default(now()) @db.Timestamp(6)
  donors           donors    @relation(fields: [donorid], references: [donorid], onDelete: Cascade, onUpdate: NoAction)
  hospitals        hospitals @relation(fields: [hospitalid], references: [hospitalid], onDelete: Cascade, onUpdate: NoAction)

  @@unique([hospitalid, donorid], map: "uq_hospital_donor")
}

model donoractivationtokens {
  tokenid   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userid    String    @db.Uuid
  tokenhash String    @db.VarChar(255)
  expiresat DateTime  @db.Timestamp(6)
  usedat    DateTime? @db.Timestamp(6)
  createdat DateTime? @default(now()) @db.Timestamp(6)
  users     users     @relation(fields: [userid], references: [userid], onDelete: Cascade, onUpdate: NoAction)
}

model inventoryledger {
  ledgerid          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryid       String                   @db.Uuid
  bloodbankid       String                   @db.Uuid
  actoruserid       String                   @db.Uuid
  operationtype     inventory_operation_type
  quantitydelta     Int
  previousavailable Int
  newavailable      Int
  previousreserved  Int
  newreserved       Int
  reason            String                   @db.VarChar(255)
  idempotencykey    String                   @unique @db.VarChar(255)
  requesthash       String                   @db.VarChar(64)
  responsecode      Int                      @default(200)
  responsebody      Json                     @db.JsonB
  createdat         DateTime?                @default(now()) @db.Timestamp(6)
  inventory         inventory                @relation(fields: [inventoryid], references: [inventoryid], onDelete: Restrict, onUpdate: NoAction, map: "fk_ledger_inventory")
  bloodbanks        bloodbanks               @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: Restrict, onUpdate: NoAction, map: "fk_ledger_bloodbank")
  users             users                    @relation(fields: [actoruserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_ledger_user")

  @@index([inventoryid], map: "idx_ledger_inventory")
  @@index([bloodbankid], map: "idx_ledger_bloodbank")
  @@index([actoruserid], map: "idx_ledger_actor")
  @@index([createdat], map: "idx_ledger_createdat")
}

enum inventory_operation_type {
  STOCK_ADDITION
  CORRECTION_INCREMENT
  CORRECTION_DECREMENT
  STOCK_INTAKE
  SCREENING_CLEARANCE
  RESERVATION_ALLOCATE
  RESERVATION_CANCEL
  UNIT_PACKED_COLD_BOX
  DISPATCH_DEPARTURE
  HOSPITAL_RECEIPT_CONFIRM
  TRANSIT_EXCURSION_RETURN
  UNIT_DISPOSAL
  OPENING_BALANCE_INITIALIZATION
}

model inventoryunits {
  unitid                       String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryid                  String                 @db.Uuid
  bloodbankid                  String                 @db.Uuid
  unitbarcode                  String                 @db.VarChar(50)
  donationidentificationnumber String?                @db.VarChar(50)
  bloodgroup                   blood_group
  bloodcomponent               blood_component
  collectiondate               DateTime?              @db.Timestamp(6)
  expirydate                   DateTime               @db.Timestamp(6)
  status                       String                 @default("QUARANTINED") @db.VarChar(30)
  ttiscreeningstatus           String                 @default("PENDING") @db.VarChar(20)
  currentscreeningid           String?                @db.Uuid
  storagebinlocation           String?                @db.VarChar(50)
  createdat                    DateTime?              @default(now()) @db.Timestamp(6)
  updatedat                    DateTime?              @default(now()) @db.Timestamp(6)
  inventory                    inventory              @relation(fields: [inventoryid], references: [inventoryid], onDelete: Restrict, onUpdate: NoAction, map: "fk_unit_inventory")
  bloodbanks                   bloodbanks             @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: Restrict, onUpdate: NoAction, map: "fk_unit_bloodbank")
  currentscreening             unitscreeningrecords?  @relation("UnitCurrentScreening", fields: [currentscreeningid], references: [screeningid], onDelete: Restrict, onUpdate: NoAction, map: "fk_unit_current_screening")
  screeninghistory             unitscreeningrecords[] @relation("UnitScreeningHistory")
  reservationitems             reservationitems[]
  clinicalcrossmatches         clinicalcrossmatches[]
  unitdispositionhistory       unitdispositionhistory[]

  @@unique([bloodbankid, unitbarcode], map: "uq_bloodbank_unitbarcode")
}

model unitscreeningrecords {
  screeningid        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitid             String                 @db.Uuid
  revisionnumber     Int                    @default(1)
  iscurrent          Boolean                @default(true)
  supersededat       DateTime?              @db.Timestamp(6)
  supersededbyuserid String?                @db.Uuid
  hivresult          String                 @db.VarChar(20)
  hbvresult          String                 @db.VarChar(20)
  hcvresult          String                 @db.VarChar(20)
  syphilisresult     String                 @db.VarChar(20)
  malariaresult      String                 @db.VarChar(20)
  overallstatus      String                 @db.VarChar(20)
  testedat           DateTime               @default(now()) @db.Timestamp(6)
  testedbyuserid     String                 @db.Uuid
  verifiedat         DateTime               @default(now()) @db.Timestamp(6)
  verifiedbyuserid   String                 @db.Uuid
  laboratoryremarks  String?
  createdat          DateTime?              @default(now()) @db.Timestamp(6)
  unit               inventoryunits         @relation("UnitScreeningHistory", fields: [unitid], references: [unitid], onDelete: Restrict, onUpdate: NoAction, map: "fk_screening_unit")
  currentforunits    inventoryunits[]       @relation("UnitCurrentScreening")
  testedby           users                  @relation("ScreeningTestedBy", fields: [testedbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_screening_tester")
  verifiedby         users                  @relation("ScreeningVerifiedBy", fields: [verifiedbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_screening_verifier")
  supersededby       users?                 @relation("ScreeningSupersededBy", fields: [supersededbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_screening_supersededby")

  @@unique([unitid, revisionnumber], map: "uq_unit_screening_revision")
}

model requisitionassignments {
  assignmentid     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestid        String             @db.Uuid
  bloodbankid      String             @db.Uuid
  assignedbyuserid String             @db.Uuid
  assignedat       DateTime           @default(now()) @db.Timestamp(6)
  assignmentstatus String             @default("PENDING_ACCEPTANCE") @db.VarChar(30)
  respondedat      DateTime?          @db.Timestamp(6)
  respondedbyuserid String?           @db.Uuid
  declinereason    String?
  createdat        DateTime?          @default(now()) @db.Timestamp(6)
  updatedat        DateTime?          @default(now()) @db.Timestamp(6)
  bloodrequests    bloodrequests      @relation(fields: [requestid], references: [requestid], onDelete: Restrict, onUpdate: NoAction, map: "fk_assignment_request")
  bloodbanks       bloodbanks         @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: Restrict, onUpdate: NoAction, map: "fk_assignment_bloodbank")
  assignedby       users              @relation("AssignmentAssignedBy", fields: [assignedbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_assignment_assignedby")
  respondedby      users?             @relation("AssignmentRespondedBy", fields: [respondedbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_assignment_respondedby")
  bloodreservations bloodreservations[]
}

model bloodreservations {
  reservationid      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestid          String                 @db.Uuid
  assignmentid       String                 @db.Uuid
  bloodbankid        String                 @db.Uuid
  reservationstatus  String                 @default("ACTIVE") @db.VarChar(30)
  reservedbyuserid   String                 @db.Uuid
  reservedat         DateTime               @default(now()) @db.Timestamp(6)
  expiresat          DateTime               @db.Timestamp(6)
  cancelledat        DateTime?              @db.Timestamp(6)
  cancelledbyuserid  String?                @db.Uuid
  cancellationreason String?
  createdat          DateTime?              @default(now()) @db.Timestamp(6)
  updatedat          DateTime?              @default(now()) @db.Timestamp(6)
  bloodrequests      bloodrequests          @relation(fields: [requestid], references: [requestid], onDelete: Restrict, onUpdate: NoAction, map: "fk_reservation_request")
  assignment         requisitionassignments @relation(fields: [assignmentid], references: [assignmentid], onDelete: Restrict, onUpdate: NoAction, map: "fk_reservation_assignment")
  bloodbanks         bloodbanks             @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: Restrict, onUpdate: NoAction, map: "fk_reservation_bloodbank")
  reservedby         users                  @relation("ReservationReservedBy", fields: [reservedbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_reservation_reservedby")
  cancelledby        users?                 @relation("ReservationCancelledBy", fields: [cancelledbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_reservation_cancelledby")
  reservationitems   reservationitems[]
  clinicalcrossmatches clinicalcrossmatches[]
}

model reservationitems {
  itemid           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationid    String                 @db.Uuid
  unitid           String                 @db.Uuid
  itemstatus       String                 @default("RESERVED") @db.VarChar(30)
  allocatedat      DateTime               @default(now()) @db.Timestamp(6)
  preparedat       DateTime?              @db.Timestamp(6)
  dispatchedat     DateTime?              @db.Timestamp(6)
  deliveredat      DateTime?              @db.Timestamp(6)
  releasedat       DateTime?              @db.Timestamp(6)
  createdat        DateTime?              @default(now()) @db.Timestamp(6)
  updatedat        DateTime?              @default(now()) @db.Timestamp(6)
  reservation      bloodreservations      @relation(fields: [reservationid], references: [reservationid], onDelete: Restrict, onUpdate: NoAction, map: "fk_item_reservation")
  unit             inventoryunits         @relation(fields: [unitid], references: [unitid], onDelete: Restrict, onUpdate: NoAction, map: "fk_item_unit")
  clinicalcrossmatches clinicalcrossmatches[]

  @@unique([reservationid, unitid], map: "uq_reservation_unit")
}

model clinicalcrossmatches {
  crossmatchid       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reservationitemid  String             @db.Uuid
  reservationid      String             @db.Uuid
  requestid          String             @db.Uuid
  unitid             String             @db.Uuid
  attemptnumber      Int                @default(1)
  iscurrent          Boolean            @default(true)
  isinvalidated      Boolean            @default(false)
  invalidationreason String?
  methodology        String             @db.VarChar(50)
  testresult         String             @db.VarChar(30)
  validuntil         DateTime           @db.Timestamp(6)
  testedat           DateTime           @default(now()) @db.Timestamp(6)
  testedbyuserid     String             @db.Uuid
  verifiedat         DateTime           @default(now()) @db.Timestamp(6)
  verifiedbyuserid   String             @db.Uuid
  createdat          DateTime?          @default(now()) @db.Timestamp(6)
  item               reservationitems   @relation(fields: [reservationitemid], references: [itemid], onDelete: Restrict, onUpdate: NoAction, map: "fk_crossmatch_item")
  reservation        bloodreservations  @relation(fields: [reservationid], references: [reservationid], onDelete: Restrict, onUpdate: NoAction, map: "fk_crossmatch_reservation")
  request            bloodrequests      @relation(fields: [requestid], references: [requestid], onDelete: Restrict, onUpdate: NoAction, map: "fk_crossmatch_request")
  unit               inventoryunits     @relation(fields: [unitid], references: [unitid], onDelete: Restrict, onUpdate: NoAction, map: "fk_crossmatch_unit")
  testedby           users              @relation("CrossmatchTestedBy", fields: [testedbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_crossmatch_tester")
  verifiedby         users              @relation("CrossmatchVerifiedBy", fields: [verifiedbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_crossmatch_verifier")

  @@unique([reservationitemid, attemptnumber], map: "uq_crossmatch_item_attempt")
}

model unitdispositionhistory {
  dispositionid      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitid             String         @db.Uuid
  bloodbankid        String         @db.Uuid
  actoruserid        String         @db.Uuid
  previousstatus     String         @db.VarChar(30)
  newstatus          String         @db.VarChar(30)
  reason             String         @db.VarChar(255)
  temperaturereading Decimal?       @db.Decimal(4, 2)
  notes              String?
  createdat          DateTime?      @default(now()) @db.Timestamp(6)
  unit               inventoryunits @relation(fields: [unitid], references: [unitid], onDelete: Restrict, onUpdate: NoAction, map: "fk_disposition_unit")
  bloodbank          bloodbanks     @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: Restrict, onUpdate: NoAction, map: "fk_disposition_bloodbank")
  actor              users          @relation("DispositionActor", fields: [actoruserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_disposition_actor")
}

