  createdbyuser         users                       @relation("maintenance_creator", fields: [createdbyuserid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_maintenance_creator")

  @@index([equipmentid], map: "idx_maintenance_equipment")
  @@index([bloodbankid], map: "idx_maintenance_bloodbank")
  @@index([status], map: "idx_maintenance_status")
}

model equipmentbreakdowns {
  breakdownid           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipmentid           String             @db.Uuid
  bloodbankid           String             @db.Uuid
  reportedat            DateTime?          @default(now()) @db.Timestamp(6)
  reportedbyuserid      String             @db.Uuid
  issue                 String             @db.VarChar(255)
  description           String?
  severity              breakdown_severity @default(MAJOR)
  status                breakdown_status   @default(REPORTED)
  impactonstorage       Boolean            @default(false)
  sopactiontaken        String?
  resolutiondetails     String?
  resolvedat            DateTime?          @db.Timestamp(6)
  resolvedbyuserid      String?            @db.Uuid
  createdat             DateTime?          @default(now()) @db.Timestamp(6)

  equipment             equipment          @relation(fields: [equipmentid], references: [equipmentid], onDelete: Cascade, onUpdate: NoAction, map: "fk_breakdown_equipment")
  bloodbanks            bloodbanks         @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: Cascade, onUpdate: NoAction, map: "fk_breakdown_bloodbank")
  reportedbyuser        users              @relation("breakdown_reporter", fields: [reportedbyuserid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_breakdown_reporter")
  resolvedbyuser        users?             @relation("breakdown_resolver", fields: [resolvedbyuserid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_breakdown_resolver")

  @@index([equipmentid], map: "idx_breakdown_equipment")
  @@index([bloodbankid], map: "idx_breakdown_bloodbank")
  @@index([status], map: "idx_breakdown_status")
}

model equipmentstatushistory {
  historyid             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipmentid           String             @db.Uuid
  bloodbankid           String             @db.Uuid
  previousstatus        String             @db.VarChar(50)
  newstatus             String             @db.VarChar(50)
  reason                String
  changedbyuserid       String             @db.Uuid
  createdat             DateTime?          @default(now()) @db.Timestamp(6)

  equipment             equipment          @relation(fields: [equipmentid], references: [equipmentid], onDelete: Cascade, onUpdate: NoAction, map: "fk_statushistory_equipment")
  bloodbanks            bloodbanks         @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: Cascade, onUpdate: NoAction, map: "fk_statushistory_bloodbank")
  changedbyuser         users              @relation("status_changed_by", fields: [changedbyuserid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_statushistory_user")

  @@index([equipmentid], map: "idx_statushistory_equipment")
}

model equipmentcategories {
