model donationcamps {
  campid                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bloodbankid              String                         @db.Uuid
  createdbyuserid          String                         @db.Uuid
  campname                 String                         @db.VarChar(255)
  description              String?                        @db.Text
  organizername            String                         @db.VarChar(255)
  contactperson            String                         @db.VarChar(100)
  contactphone             String?                        @db.VarChar(20)
  campdate                 DateTime                       @db.Date
  starttime                DateTime                       @db.Time(6)
  endtime                  DateTime                       @db.Time(6)
  timezone                 String                         @default("Asia/Kolkata") @db.VarChar(50)
  registrationopeningdate  DateTime                       @db.Timestamp(6)
  registrationdeadline     DateTime                       @db.Timestamp(6)
  venuename                String                         @db.VarChar(255)
  address                  String                         @db.VarChar(255)
  city                     String                         @db.VarChar(100)
  district                 String                         @db.VarChar(100)
  state                    String                         @db.VarChar(100)
  pincode                  String                         @db.VarChar(10)
  latitude                 Decimal?                       @db.Decimal(9, 6)
  longitude                Decimal?                       @db.Decimal(9, 6)
  isregistrationrequired   Boolean                        @default(true)
  maxcapacity              Int?
  registrationinstructions String?                        @db.Text
  donorinstructions        String?                        @db.Text
  eligibilitynotes         String?                        @db.Text
  status                   camp_status                    @default(DRAFT)
  registrationstatus       camp_registration_availability @default(OPEN)
  cancellationreason       String?                        @db.Text
  createdat                DateTime?                      @default(now()) @db.Timestamp(6)
  updatedat                DateTime?                      @default(now()) @db.Timestamp(6)

  bloodbanks               bloodbanks                     @relation(fields: [bloodbankid], references: [bloodbankid], onDelete: Restrict, onUpdate: NoAction, map: "fk_camp_bloodbank")
  createdby                users                          @relation("CampCreatedBy", fields: [createdbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_camp_creator")
  registrations            campregistrations[]
  statushistory            campstatushistory[]
  audithistory             campaudithistory[]
  notifications            notification[]

  @@index([bloodbankid], map: "idx_camps_bloodbank")
  @@index([campdate], map: "idx_camps_campdate")
  @@index([status], map: "idx_camps_status")
  @@index([city], map: "idx_camps_city")
  @@index([district], map: "idx_camps_district")
  @@index([state], map: "idx_camps_state")
}

model campregistrations {
  registrationid             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campid                     String                   @db.Uuid
  donorid                    String                   @db.Uuid
  registrationreference      String                   @unique @db.VarChar(50)
  registrationdate           DateTime                 @default(now()) @db.Timestamp(6)
  registrationstatus         camp_registration_status @default(REGISTERED)
  attendancestatus           camp_attendance_status   @default(PENDING)
  attendedat                 DateTime?                @db.Timestamp(6)
  unitsdonated               Int?
  attendancenotes            String?                  @db.Text
  cancellationreason         String?                  @db.Text
  cancelledat                DateTime?                @db.Timestamp(6)
  cancelledbyuserid          String?                  @db.Uuid
  attendanceupdatedbyuserid  String?                  @db.Uuid
  previouscancellationreason String?                  @db.Text
  previouscancelledat        DateTime?                @db.Timestamp(6)
  cancellationhistory        Json?                    @default("[]")
  reregisteredat             DateTime?                @db.Timestamp(6)
  createdat                  DateTime?                @default(now()) @db.Timestamp(6)
  updatedat                  DateTime?                @default(now()) @db.Timestamp(6)

  camp                       donationcamps            @relation(fields: [campid], references: [campid], onDelete: Restrict, onUpdate: NoAction, map: "fk_campreg_camp")
  donor                      donors                   @relation(fields: [donorid], references: [donorid], onDelete: Restrict, onUpdate: NoAction, map: "fk_campreg_donor")
  cancelledby                users?                   @relation("CampRegCancelledBy", fields: [cancelledbyuserid], references: [userid], onDelete: SetNull, onUpdate: NoAction, map: "fk_campreg_canceller")
  attendanceupdatedby        users?                   @relation("CampRegAttendanceUpdatedBy", fields: [attendanceupdatedbyuserid], references: [userid], onDelete: SetNull, onUpdate: NoAction, map: "fk_campreg_attendance_updater")
  notifications              notification[]

  @@unique([campid, donorid], map: "uq_camp_donor_registration")
  @@index([campid], map: "idx_campreg_camp")
  @@index([donorid], map: "idx_campreg_donor")
  @@index([registrationstatus], map: "idx_campreg_status")
  @@index([attendancestatus], map: "idx_campreg_attendance")
  @@index([attendanceupdatedbyuserid], map: "idx_campreg_attendance_updater")
}

model campstatushistory {
  historyid       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campid          String        @db.Uuid
  oldstatus       camp_status?
  newstatus       camp_status
  changedbyuserid String        @db.Uuid
  reason          String?       @db.Text
  createdat       DateTime?     @default(now()) @db.Timestamp(6)

  camp            donationcamps @relation(fields: [campid], references: [campid], onDelete: Restrict, onUpdate: NoAction, map: "fk_camphist_camp")
  changedby       users         @relation("CampHistoryChangedBy", fields: [changedbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_camphist_user")

  @@index([campid], map: "idx_camphist_camp")
}

model campaudithistory {
  auditid         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campid          String        @db.Uuid
  action          String        @db.VarChar(50)
  changedbyuserid String        @db.Uuid
  details         String?       @db.Text
  createdat       DateTime?     @default(now()) @db.Timestamp(6)

  camp            donationcamps @relation(fields: [campid], references: [campid], onDelete: Restrict, onUpdate: NoAction, map: "fk_campaudit_camp")
  changedby       users         @relation("CampAuditChangedBy", fields: [changedbyuserid], references: [userid], onDelete: Restrict, onUpdate: NoAction, map: "fk_campaudit_user")

  @@index([campid], map: "idx_campaudit_camp")
}

model donornotificationpreferences {
  preferenceid       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donorid            String    @unique @db.Uuid
  nearbycamps        Boolean   @default(true)
  campreminders      Boolean   @default(true)
  campupdates        Boolean   @default(true)
  campcancellations  Boolean   @default(true)
  preferredcity      String?   @db.VarChar(100)
  preferredradiuskm  Int?      @default(25)
  createdat          DateTime? @default(now()) @db.Timestamp(6)
  updatedat          DateTime? @default(now()) @db.Timestamp(6)
  donor              donors    @relation(fields: [donorid], references: [donorid], onDelete: Cascade, onUpdate: NoAction, map: "fk_donor_notif_pref")

  @@index([donorid], map: "idx_donor_notif_pref_donor")
}

